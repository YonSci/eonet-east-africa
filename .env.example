# ─────────────────────────────────────────────────────────────
#  EONET East Africa Dashboard  --  Environment Variables
#  Copy this file to .env and fill in values before running.
# ─────────────────────────────────────────────────────────────

# ── EONET API ─────────────────────────────────────────────────
# Base URL for NASA EONET v3 API (do not change unless NASA moves it)
EONET_BASE_URL=https://eonet.gsfc.nasa.gov/api/v3

# ── East Africa bounding box ──────────────────────────────────
# Format required by EONET: min_lon, max_lat, max_lon, min_lat
# Covers: Ethiopia, Kenya, Tanzania, Uganda, Somalia, South Sudan,
#         Eritrea, Djibouti, Rwanda, Burundi, parts of Mozambique
EA_BBOX_MIN_LON=21.8
EA_BBOX_MAX_LAT=22.0
EA_BBOX_MAX_LON=51.4
EA_BBOX_MIN_LAT=-11.7

# ── Default query parameters ──────────────────────────────────
EONET_DEFAULT_DAYS=90
EONET_DEFAULT_LIMIT=500
EONET_DEFAULT_STATUS=all

# ── Polling / cache ───────────────────────────────────────────
# How often (seconds) the backend auto-refreshes EONET data
REFRESH_INTERVAL_SECONDS=900

# ── Server ────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── CORS (comma-separated allowed origins) ────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -- Email alerts (optional) -----------------------------------------------
# Required only for email alert subscriptions feature.
# Gmail: enable 2FA then create an App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=noreply@net-ea.org
